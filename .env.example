# LLM provider: "gemini" or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: model override for the selected provider
LLM_MODEL=

# Where cached transcripts and exports are stored
DATA_DIR=./data

# Base URL the Streamlit UI uses to reach the API
API_URL=http://localhost:8000
